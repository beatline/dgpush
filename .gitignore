# ======= 编译产物与执行文件 / Binaries =======
# 忽略所有 bin 目录及其下的执行文件
bin/
push-gateway/push-gateway
push-worker/push-worker
# Windows 下的可执行文件
*.exe
*.exe~
*.dll
*.so
*.dylib

# ======= 日志文件 / Logs =======
# 忽略项目生成的日志文件夹
**/logs/
*.log

# ======= 敏感配置文件与证书 / Configs & Secrets =======
# ！！！极其重要：忽略厂商推送证书文件 ！！！
**/scripts/v1/*.json

# 忽略本地实际运行的配置文件（防止泄露数据库密码、Redis密钥等）
**/configs/config.yaml

# 如果你有 .env 环境变量文件
.env

# ======= Go 依赖与环境 / Go Specific =======
# 如果你使用了 vendor 模式，通常不建议上传
vendor/
# Go 工作区文件
go.work
go.work.sum
# 版本管理工具生成的临时文件
.go-version

# ======= 操作系统冗余 / System Files =======
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Ehthumbs.db
Thumbs.db

# ======= IDE 与 编辑器 / IDEs & Editors =======
# JetBrains (GoLand / IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / Emacs
*~
*.swp
*.swo

# ======= 临时文件 / Temporary =======
.tmp/
temp/